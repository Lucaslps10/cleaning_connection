enum UserType {
    CLIENTE
    DIARISTA
}

model User {
    id String @id @default(uuid())
    email String @unique @db.VarChar(255)
    password String
    userType UserType @default(CLIENTE) @map("user_type")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    // Esse trecho faz com que um usuário tenha apenas um perfil de cliente ou diarista.
    client Client?
    diarist Diarist?

    @@map("users") 
}
